# xiq-client credentials — copy to `.env` and fill in.
# NEVER commit the real .env (it is already in .gitignore).
#
# Requires the dotenv extra:  pip install "xiq-client[dotenv]"
# Real environment variables always take precedence over this file.

# Preferred: a Platform ONE key (extr_sk_...) from
# Administration & Settings > Integrations. Works with either endpoint.
# Alternatively: an XIQ /login or /auth/apitoken credential (api.extremecloudiq.com only).
XIQ_API_TOKEN=

# Optional. Default is https://api.extremecloudiq.com
# Platform ONE: https://cloudapi.extremecloudiq.com/xiq/v1
# XIQ_BASE_URL=

# Fallback — used only if XIQ_API_TOKEN is empty. Obtains a 24-hour /login token each run.
# XIQ_USERNAME=you@example.com
# XIQ_PASSWORD=
